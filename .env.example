# ==========================================================
# ULTRON - Local AI Operating System Configuration
# ==========================================================

# GEMINI_API_KEY: Optional cloud fallback for Gemini AI.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Cloud Run / Hosting service URL
APP_URL="MY_APP_URL"

# OLLAMA CONFIGURATION (Primary Local AI Engine)
# Ensure Ollama is running locally (e.g. `ollama serve`)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
DEFAULT_OLLAMA_MODEL="qwen2.5-coder:7b"
FALLBACK_OLLAMA_MODEL="llama3.2:3b"

# ELEVENLABS VOICE ASSISTANT (Primary Neural TTS Voice)
# Voice ID specified for ULTRON: 1SM7GgM6IMuvQlz2BwM3
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="1SM7GgM6IMuvQlz2BwM3"

# KALI LINUX SYSTEM & TERMINAL SETTINGS
# Allowed workspace path for file operations
ULTRON_WORKSPACE_PATH="/app/applet"
ENABLE_REAL_TERMINAL="true"
REQUIRE_ROOT_APPROVAL="true"
